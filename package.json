{
  "name": "finops-assistant-monorepo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "docker:build": "turbo run docker:build",
    "openspec": "openspec",
    "openspec:list": "openspec list",
    "openspec:status": "openspec status",
    "openspec:validate": "openspec validate --all --strict --no-interactive",
    "openspec:archive": "openspec archive",
    "jup:check": "node tools/jup-check.mjs",
    "jup:check:test": "node --test tools/jup-check.test.mjs",
    "jup:cleanup:check": "node tools/jup-cleanup-check.mjs",
    "jup:cleanup:test": "node --test tools/jup-cleanup-check.test.mjs",
    "assistant-corpus:validate": "node tools/assistant-corpus.mjs validate",
    "assistant-corpus:test": "node --test tools/assistant-corpus.test.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.8.0",
    "turbo": "^2.0.0",
    "yaml": "2.9.0"
  }
}
