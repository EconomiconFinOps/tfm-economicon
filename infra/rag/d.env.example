# D: overlay for an operator-owned complete environment, AFTER all tenant heads are verified.
# Never use this file alone. Empty identity fields deliberately prevent verified startup.
EMBEDDING_PROVIDER=litellm
EMBEDDING_DIMENSION=1536
EMBEDDING_MODEL=economicon-embedding
EMBEDDING_MAPPING_SHA256=
EMBEDDING_DEPLOYMENT_ID=
EMBEDDING_CHUNK_TARGET_TOKENS=600
EMBEDDING_CHUNK_MAX_TOKENS=800
EMBEDDING_CHUNK_OVERLAP_RATIO=0.1
RETRIEVAL_TOP_K=4
RETRIEVAL_MAX_DISTANCE=0.6
RAG_VERIFIED_ENABLED=true
RAG_CONTEXTUAL_ENABLED=true
RAG_HYBRID_ENABLED=true
