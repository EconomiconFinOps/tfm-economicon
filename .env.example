API_HOST_PORT=8000
# Required secrets below are intentionally empty. Copying this file is not enough.
# Python reads only an explicitly selected ECONOMICON_ENV_FILE; environment wins.
RUNTIME_ENVIRONMENT=production
# Opt in only after confirming isolated, disposable local data and loopback ports.
ALLOW_INSECURE_LOCAL_DATABASE=false
DEMO_SEED_ENABLED=false
DEMO_PASSWORD=
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
POSTGRES_PASSWORD=
# Preserve the existing Grafana password when moving it to ignored .env.
GRAFANA_ADMIN_PASSWORD=
# Gateway-only keys: never inject these into backend/processor/frontend.
OPENROUTER_API_KEY=
LITELLM_MASTER_KEY=
PROCESSOR_HOST_PORT=8001
FRONTEND_HOST_PORT=5173
AZURE_COST_API_HOST_PORT=8002
COCKROACH_SQL_PORT=26257
COCKROACH_HTTP_PORT=8080
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
PGVECTOR_PORT=5433
# AZURE_COST_* tokens below are synthetic simulator fixtures, never Azure keys.
AZURE_COST_AUTH_ENABLED=true
AZURE_COST_VALID_TOKENS=jupiter-local-token
AZURE_COST_FORBIDDEN_TOKENS=jupiter-forbidden-token
AZURE_COST_PAGE_SIZE=10
AZURE_COST_SKIPTOKEN_SECRET=jupiter-local-skiptoken-secret
AZURE_COST_DEFAULT_SCENARIO=normal
AZURE_COST_FAKE_TIMEOUT_SECONDS=2
AZURE_COST_RETRY_AFTER_SECONDS=1
AZURE_COST_API_BASE_URL=http://azure-cost-api:8002
AZURE_COST_API_TOKEN=jupiter-local-token
AZURE_COST_API_VERSION=2025-03-01
AZURE_COST_API_TIMEOUT_SECONDS=5
AZURE_COST_API_MAX_RETRIES=3
AZURE_COST_API_RETRY_BACKOFF_SECONDS=0.25
AZURE_COST_API_MAX_RETRY_AFTER_SECONDS=30
AZURE_COST_API_MAX_PAGES=1000
PROCESSOR_CONCURRENCY=2
PROCESSOR_QUEUE_NAME=processor:jobs
# URL-encode user/password components, and match the owning server credentials.
RABBITMQ_URL=
DATABASE_URL=
VECTOR_DATABASE_URL=
EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=8
EMBEDDING_MODEL=economicon-embedding
EMBEDDING_CHUNK_SIZE=500
EMBEDDING_CHUNK_OVERLAP=50
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_MINUTES=480
VITE_API_BASE_URL=http://localhost:8000
LLM_PROVIDER=mock
LLM_MODEL=economicon-chat
AI_EXECUTION_MODE=development
LITELLM_BASE_URL=http://litellm:4000/v1
# Required only when LLM_PROVIDER or EMBEDDING_PROVIDER is litellm.
LITELLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=800
