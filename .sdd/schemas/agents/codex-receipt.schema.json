{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finops.local/sdd/agents/codex-receipt/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "status", "output_path", "input_sha256", "output_sha256"],
  "properties": {
    "run_id": { "type": "string", "format": "uuid" },
    "status": { "enum": ["COMPLETED", "BLOCKED", "FAILED"] },
    "output_path": { "type": "string" },
    "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "output_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
