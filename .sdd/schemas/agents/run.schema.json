{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finops.local/sdd/agents/run/2.0.0",
  "$defs": {
    "producer": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["actor_type", "identity"],
      "properties": {
        "actor_type": { "enum": ["human", "agent", "system"] },
        "identity": { "type": "string", "minLength": 1 }
      }
    },
    "common": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "story_id", "skill", "status", "input_path", "input_sha256", "output_path", "created_at", "submitted_at", "producer"],
      "properties": {
        "schema_version": { "enum": ["1.0.0", "2.0.0"] },
        "run_id": { "type": "string", "format": "uuid" },
        "story_id": { "type": "string", "pattern": "^HU-[0-9]{3,}$" },
        "skill": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PREPARED", "RUNNING", "VALID", "BLOCKED", "FAILED", "ABORTED", "SUBMITTED"] },
        "input_path": { "type": "string", "minLength": 1 },
        "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "output_path": { "type": "string", "minLength": 1 },
        "output_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "created_at": { "type": "string", "format": "date-time" },
        "submitted_at": { "type": ["string", "null"] },
        "producer": { "$ref": "#/$defs/producer" },
        "agent_id": { "type": "string", "minLength": 1 },
        "agent_definition_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "agent_catalog_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "permission_profile": { "$ref": "https://finops.local/sdd/agents/permission-profile/1.0.0" },
        "permission_profile_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "execution": { "$ref": "https://finops.local/sdd/agents/execution/1.0.0" }
      }
    }
  },
  "allOf": [
    { "$ref": "#/$defs/common" },
    {
      "oneOf": [
        {
          "properties": { "schema_version": { "const": "1.0.0" } },
          "not": { "anyOf": [
            { "required": ["agent_id"] }, { "required": ["agent_definition_sha256"] },
            { "required": ["agent_catalog_sha256"] }, { "required": ["permission_profile"] },
            { "required": ["permission_profile_sha256"] }, { "required": ["execution"] }
          ] }
        },
        {
          "required": ["agent_id", "agent_definition_sha256", "agent_catalog_sha256", "permission_profile", "permission_profile_sha256"],
          "properties": { "schema_version": { "const": "2.0.0" } }
        }
      ]
    },
    {
      "if": { "properties": { "status": { "enum": ["RUNNING", "VALID", "BLOCKED", "FAILED", "ABORTED", "SUBMITTED"] } }, "required": ["status"] },
      "then": {
        "if": { "properties": { "schema_version": { "const": "2.0.0" } }, "required": ["schema_version"] },
        "then": { "required": ["execution"] }
      }
    },
    {
      "if": { "properties": { "status": { "const": "SUBMITTED" } }, "required": ["status"] },
      "then": { "required": ["output_sha256"], "properties": { "submitted_at": { "type": "string", "format": "date-time" }, "producer": { "type": "object" } } }
    }
  ]
}
