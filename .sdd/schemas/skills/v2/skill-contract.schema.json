{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://economicon.local/sdd/skills/skill-contract/2.0.0",
  "$defs": {
    "repoPath": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fileRef": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "$ref": "#/$defs/repoPath" }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "artifactRef": { "type": "object", "additionalProperties": false, "required": ["type", "path", "version", "sha256", "status"], "properties": { "type": { "type": "string" }, "path": { "$ref": "#/$defs/repoPath" }, "version": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/sha256" }, "status": { "enum": ["DRAFT", "CHANGES_REQUESTED", "APPROVED", "REJECTED"] } } },
    "candidate": { "type": "object", "additionalProperties": false, "required": ["type", "artifact_schema_version", "staged_path", "target_path", "sha256"], "properties": { "type": { "enum": ["user-story", "prd", "tdr", "roadmap", "task", "execution-summary", "verification-evidence", "review"] }, "artifact_schema_version": { "const": "1.0.0" }, "staged_path": { "$ref": "#/$defs/repoPath" }, "target_path": { "$ref": "#/$defs/repoPath" }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "scope": { "type": "object", "additionalProperties": false, "required": ["components", "affected_data", "affected_flows", "read_paths", "write_paths"], "properties": { "components": { "type": "array", "items": { "type": "string" } }, "affected_data": { "type": "array", "items": { "type": "string" } }, "affected_flows": { "type": "array", "items": { "type": "string" } }, "read_paths": { "type": "array", "items": { "$ref": "#/$defs/repoPath" } }, "write_paths": { "type": "array", "items": { "$ref": "#/$defs/repoPath" } } } },
    "docsContext": { "type": "object", "additionalProperties": false, "required": ["inventory", "applicable", "excluded"], "properties": { "inventory": { "type": "array", "items": { "$ref": "#/$defs/repoPath" } }, "applicable": { "type": "array", "items": { "$ref": "#/$defs/fileRef" } }, "excluded": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "reason"], "properties": { "path": { "$ref": "#/$defs/repoPath" }, "reason": { "type": "string", "minLength": 1 } } } } } },
    "trace": { "type": "object", "additionalProperties": false, "required": ["from", "to", "type"], "properties": { "from": { "type": "string", "minLength": 1 }, "to": { "type": "string", "minLength": 1 }, "type": { "enum": ["defines", "satisfies", "constrained_by", "implements", "verified_by", "produces", "finds", "closes", "depends_on"] } } },
    "error": { "type": "object", "additionalProperties": false, "required": ["code", "message", "path"], "properties": { "code": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 }, "path": { "type": ["string", "null"] } } },
    "conflict": { "type": "object", "additionalProperties": false, "required": ["code", "paths", "summary", "blocking"], "properties": { "code": { "const": "DOC-CONFLICT" }, "paths": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/repoPath" } }, "summary": { "type": "string", "minLength": 1 }, "blocking": { "type": "boolean" } } },
    "inputBase": { "type": "object", "additionalProperties": false, "required": ["schema_version", "run_id", "correlation_id", "skill", "story_id", "workflow_stage", "state_sha256", "artifact_versions", "docs_context", "requested_scope", "parameters"], "properties": { "schema_version": { "const": "2.0.0" }, "run_id": { "type": "string", "format": "uuid" }, "correlation_id": { "type": "string", "format": "uuid" }, "skill": { "enum": ["spec-intake", "prd-generator", "tdr-generator", "task-planner", "plan-executor", "verifier", "reviewer"] }, "story_id": { "type": "string", "pattern": "^HU-[0-9]{3,}$" }, "workflow_stage": { "enum": ["INTAKE", "PRD", "TDR", "PLAN", "EXECUTION", "VERIFICATION", "REVIEW"] }, "state_sha256": { "$ref": "#/$defs/sha256" }, "artifact_versions": { "type": "array", "items": { "$ref": "#/$defs/artifactRef" } }, "docs_context": { "$ref": "#/$defs/docsContext" }, "requested_scope": { "$ref": "#/$defs/scope" }, "parameters": { "type": "object" } } },
    "outputBase": { "type": "object", "additionalProperties": false, "required": ["schema_version", "run_id", "input_sha256", "correlation_id", "skill", "status", "artifacts", "docs_consulted", "doc_conflicts", "traceability", "errors", "result"], "properties": { "schema_version": { "const": "2.0.0" }, "run_id": { "type": "string", "format": "uuid" }, "input_sha256": { "$ref": "#/$defs/sha256" }, "correlation_id": { "type": "string", "format": "uuid" }, "skill": { "enum": ["spec-intake", "prd-generator", "tdr-generator", "task-planner", "plan-executor", "verifier", "reviewer"] }, "status": { "enum": ["COMPLETED", "BLOCKED", "FAILED"] }, "artifacts": { "type": "array", "items": { "$ref": "#/$defs/candidate" } }, "docs_consulted": { "type": "array", "items": { "$ref": "#/$defs/fileRef" } }, "doc_conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } }, "traceability": { "type": "array", "items": { "$ref": "#/$defs/trace" } }, "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }, "result": { "type": "object" } } },
    "taskDescriptor": { "type": "object", "additionalProperties": false, "required": ["id", "path", "depends_on", "required_checks"], "properties": { "id": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" }, "path": { "$ref": "#/$defs/repoPath" }, "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" } }, "required_checks": { "type": "array", "items": { "type": "string", "pattern": "^TEST-[0-9]{3,}$" } } } },
    "checkDescriptor": { "type": "object", "additionalProperties": false, "required": ["id", "name", "command", "cwd"], "properties": { "id": { "type": "string", "pattern": "^TEST-[0-9]{3,}$" }, "name": { "type": "string", "minLength": 1 }, "command": { "type": "string", "minLength": 1 }, "cwd": { "$ref": "#/$defs/repoPath" } } },
    "taskResult": { "type": "object", "additionalProperties": false, "required": ["task_id", "status", "reason", "evidence"], "properties": { "task_id": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" }, "status": { "enum": ["COMPLETED", "FAILED", "BLOCKED"] }, "reason": { "type": ["string", "null"] }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/fileRef" } } } },
    "finding": { "type": "object", "additionalProperties": false, "required": ["id", "summary", "severity", "status", "cause", "requirement_ids", "task_ids", "invariant_ids", "evidence", "resolution"], "properties": { "id": { "type": "string", "pattern": "^FIND-[0-9]{3,}$" }, "summary": { "type": "string", "minLength": 1 }, "severity": { "enum": ["BLOCKING", "HIGH", "MEDIUM", "LOW"] }, "status": { "const": "OPEN" }, "cause": { "enum": ["scope_or_story", "requirements", "design_or_architecture", "planning_or_dependencies", "implementation_or_tests", "verification_failure_requires_implementation_change", "verification_evidence_refresh_without_implementation_change"] }, "requirement_ids": { "type": "array", "items": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" } }, "task_ids": { "type": "array", "items": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" } }, "invariant_ids": { "type": "array", "items": { "type": "string", "pattern": "^ARCH-[0-9]{2}$" } }, "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fileRef" } }, "resolution": { "type": "null" } }, "anyOf": [{ "properties": { "requirement_ids": { "minItems": 1 } } }, { "properties": { "task_ids": { "minItems": 1 } } }, { "properties": { "invariant_ids": { "minItems": 1 } } }] }
  }
}
