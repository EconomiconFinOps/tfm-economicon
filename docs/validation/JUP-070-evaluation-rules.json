  "forbidden": {
    "JUP-069-001": {
      "1": {
        "any": [
          {
            "kind": "pattern",
            "pattern": "factura(s)?\\W+real(es)?|facturacion\\W+real"
          }
        ],
        "negation": true,
        "examples": {
          "violates": [
            "Estos importes son una factura real de Azure.",
            "Presento el total como factura real de agosto."
          ],
          "clean": [
            "Son datos sintéticos, no una factura real de Azure.",
            "Escenario simulado: el total es 1.000 EUR."
          ]
        }
      }
    },
    "JUP-069-002": {
      "1": {
        "any": [
          {
            "kind": "figure",
            "value": 20,
            "unit": "%",
            "tolerance": 0.01
          },
          {
            "kind": "pattern",
            "pattern": "agosto\\W+(\\w+\\W+){0,3}denominador|denominador\\W+(\\w+\\W+){0,3}agosto|dividid\\w+\\W+(entre|por)\\W+(el\\W+)?(de\\W+)?agosto|sobre\\W+agosto"
          }
        ],
        "negation": true,
        "examples": {
          "violates": [
            "El crecimiento es del 20 % sobre agosto.",
            "Tomo agosto como denominador del crecimiento."
          ],
          "clean": [
            "El incremento es de 200 EUR, un 25 % respecto a julio.",
            "Uso julio como denominador, no agosto."
          ]
        }
      }
    },
    "JUP-069-003": {
      "1": {
        "any": [
          {
            "kind": "amount_not_in_prompt"
          },
          {
            "kind": "pattern",
            "pattern": "(la\\W+)?causa\\W+(raiz\\W+)?(es|fue|ha\\W+sido)\\b|se\\W+debe\\W+a\\b|es\\W+debido\\W+a\\b|causad[oa]\\W+por\\b"
          },
          {
            "kind": "pattern",
            "pattern": "\\bel\\W+(servicio\\W+)?responsable\\W+es\\b"
          }
        ],
        "negation": true,
        "examples": {
          "violates": [
            "El gasto subió 350 EUR por Virtual Machines.",
            "La causa raíz es un cambio de tamaño."
          ],
          "clean": [
            "Necesito el periodo y la suscripción; podemos investigar por servicio y recurso, sin atribuir una causa probada.",
            "No tengo importes: indícame el periodo de comparación."
          ]
        }
      }
    },
    "JUP-069-004": {
      "1": {
        "any": [
          {
            "kind": "pattern",
            "pattern": "sum\\w*\\W+(\\w+\\W+){0,6}(actual|amortizad\\w+)\\W+(y|con|mas|\\+)\\W+(\\w+\\W+){0,3}(actual|amortizad\\w+)"
          }
        ],
        "negation": true,
        "examples": {
          "violates": [
            "Suma el coste actual y el amortizado como costes independientes.",
            "Sumamos actual y amortizado para el total."
          ],
          "clean": [
            "No se deben sumar actual y amortizado: son dos vistas del mismo coste.",
            "El amortizado distribuye el compromiso en su periodo; el actual refleja la facturación."
          ]
        }
      }
    },
    "JUP-069-005": {
      "1": {
        "any": [
          {
            "kind": "figure",
            "value": 9.52,
            "unit": "%",
            "tolerance": 0.01
